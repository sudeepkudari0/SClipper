# Mistral API key (required for LLM, vision, and transcription)
MISTRAL_API_KEY=

# Optional global default model override
# MISTRAL_MODEL=mistral-small-latest

# Optional per-task model overrides
# MISTRAL_MODEL_PLAN=ministral-14b-2512
# MISTRAL_MODEL_MOMENTS=ministral-14b-2512
# MISTRAL_MODEL_DRAFT=ministral-8b-2512
# MISTRAL_MODEL_VISION=ministral-14b-2512
# MISTRAL_MODEL_TRANSCRIBE=voxtral-mini-latest

# Rate limiting (minimum interval between Mistral API calls in ms)
MISTRAL_MIN_INTERVAL_MS=1100

# Optional local whisper command template for `clipper transcribe` (provider: whisper-cmd)
# WHISPER_CMD="whisper-cli -m /path/to/model.bin -f {wav} -oj -of {out}"

# Optional Pexels API key for `clipper stock` / `clipper run --stock "..."`
# PEXELS_API_KEY=

